#!/bin/sh
# SPDX-License-Identifier: Apache-2.0
. /usr/share/libubox/jshn.sh

saved=0
applied=0
pending=0
job=
tmp=
jobfile=
lock=/var/lock/duck-editor.lock
jobs=/var/run/duck-editor

reply() {
	json_init
	json_add_boolean saved "$saved"
	json_add_boolean applied "$applied"
	json_add_boolean pending "$pending"
	json_add_string job "$job"
	json_add_string error "$1"
	json_dump
}

cleanup() {
	[ -z "$tmp" ] || rm -f "$tmp" "$tmp.log"
	# Never unlink a flock file: waiters must continue to lock the same inode.
	# The kernel releases fd 9 even if rpcd or the worker is killed.
}

publish() {
	reply "$1" > "$jobfile.next" && mv -f "$jobfile.next" "$jobfile"
}

finish() {
	pending=0
	cleanup
	exec 9>&-
	publish "$1"
}

run_transaction() {
	local output attempt
	trap cleanup EXIT
	trap 'finish "Configuration operation was interrupted; reload to check its state"; exit 1' HUP INT TERM
	if ! /usr/bin/dae validate -c "$tmp" > "$tmp.log" 2>&1; then
		output="$(head -c 4096 "$tmp.log")"
		finish "Configuration validation failed: $output"
		return
	fi
	# Same-filesystem rename: failed validation/write never damages the old file.
	mv -f "$tmp" /etc/duck/config.dae || { finish 'Cannot replace configuration'; return; }
	saved=1
	if [ "$apply" = 1 ]; then
		publish ''
		# The dedicated command fails safely with older duck packages too;
		# never fall back to restart, which downloads over the edited file.
		if ! /etc/init.d/duck editor_apply > "$tmp.log" 2>&1; then
			output="$(head -c 4096 "$tmp.log")"
			finish "Configuration saved, but service apply failed: $output"
			return
		fi
		# procd may return from start before the instance is visible.
		for attempt in 1 2 3 4 5; do
			if /etc/init.d/duck running >/dev/null 2>&1; then
				applied=1
				break
			fi
			sleep 1
		done
		if [ "$applied" != 1 ]; then
			finish 'Configuration saved, but the service is not running (check whether it is enabled)'
			return
		fi
	fi
	finish ''
}

save_config() {
	local content apply content_type apply_type configured
	json_load "$(cat)" || { reply 'Invalid request'; return; }
	json_get_type content_type content
	json_get_type apply_type apply
	[ "$content_type" = string ] && [ "$apply_type" = boolean ] || {
		reply 'Invalid request'; return;
	}
	json_get_var content content
	json_get_var apply apply
	case "$content" in
		*[![:space:]]*) ;;
		*) reply 'Configuration cannot be empty'; return ;;
	esac
	configured="$(uci -q get duck.config.config_file)"
	[ -z "$configured" ] || [ "$configured" = /etc/duck/config.dae ] || {
		reply 'The editor only supports /etc/duck/config.dae'; return;
	}
	umask 077
	mkdir -p /var/lock /etc/duck "$jobs" || { reply 'Cannot create configuration directory'; return; }
	chmod 0700 "$jobs" || { reply 'Cannot protect operation directory'; return; }
	{ exec 9>"$lock"; } || { reply 'Cannot open configuration lock'; return; }
	flock -n 9 || { reply 'Another configuration save is in progress'; return; }
	trap cleanup EXIT
	# Relative includes resolve against /etc/duck, just like the real entry.
	# No .dae suffix avoids matching typical include globs.
	tmp="$(mktemp /etc/duck/.editor-XXXXXX)" || { reply 'Cannot create temporary configuration'; return; }
	printf '%s' "$content" > "$tmp" || { reply 'Cannot write temporary configuration'; return; }
	# Retain results for an hour, including when a browser disconnects.
	find "$jobs" -type f -mmin +60 -exec rm -f '{}' ';'
	jobfile="$(mktemp "$jobs/XXXXXX")" || { reply 'Cannot create operation status'; return; }
	job="${jobfile##*/}"
	pending=1
	publish '' || { pending=0; reply 'Cannot write operation status'; return; }
	# Detach all CGI/RPC pipes; the worker keeps fd 9 and owns temp cleanup.
	# Validation/reload can exceed both LuCI's and rpcd's request timeouts.
	# An explicit subshell matters: ash otherwise retains copies of the RPC
	# pipes while redirecting a function, making the caller wait for EOF.
	(run_transaction) </dev/null >/dev/null 2>&1 &
	trap - EXIT
	reply ''
}

get_status() {
	local job_type
	json_load "$(cat)" || { reply 'Invalid request'; return; }
	json_get_type job_type job
	[ "$job_type" = string ] || { reply 'Invalid operation ID'; return; }
	json_get_var job job
	case "$job" in
		''|*[!a-zA-Z0-9]*) reply 'Invalid operation ID'; return ;;
	esac
	[ "${#job}" = 6 ] || { reply 'Invalid operation ID'; return; }
	if [ -s "$jobs/$job" ]; then
		cat "$jobs/$job"
	else
		reply 'Operation status expired or unavailable; reload to check configuration'
	fi
}

case "$1" in
	list) printf '%s\n' '{"save":{"content":"String","apply":"Boolean"},"status":{"job":"String"}}' ;;
	call)
		case "$2" in
			save) save_config ;;
			status) get_status ;;
			*) reply 'Unknown method' ;;
		esac
		;;
esac
